{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@asa/domain": ["packages/domain/src/index.ts"],
      "@asa/domain/*": ["packages/domain/src/*"],
      "@asa/browser": ["packages/browser/src/index.ts"],
      "@asa/browser/*": ["packages/browser/src/*"],
      "@asa/tuss": ["packages/tuss/src/index.ts"],
      "@asa/tuss/*": ["packages/tuss/src/*"],
      "@asa/asa": ["packages/asa/src/index.ts"],
      "@asa/asa/*": ["packages/asa/src/*"],
      "@asa/storage": ["packages/storage/src/index.ts"],
      "@asa/storage/*": ["packages/storage/src/*"],
      "@asa/convenios": ["packages/convenios/src/index.ts"],
      "@asa/convenios/*": ["packages/convenios/src/*"]
    }
  }
}
